@let(errors = flashMessages.get('inputErrorsBag', {}))
@layouts.app({ title: 'Bahan pangan' })
  @page({
    title: 'Bahan pangan',
    description: 'Kandungan gizi per 100 gram berat dapat dimakan. Data TKPI di sini adalah subset awal dan perlu diverifikasi ke Tabel Komposisi Pangan Indonesia terbaru.',
  })
    <div class="vstack-lg">
      <form method="GET" action="{{ urlFor('ingredients.index') }}" class="panel row" style="padding: 16px">
        <input class="field__input" name="q" value="{{ q }}" placeholder="Cari bahan" style="flex: 1 1 200px" />
        <select name="kategori" aria-label="Kategori">
          <option value="">Semua kategori</option>
          @each(c in categories)
            <option value="{{ c }}" {{ c === category ? 'selected' : '' }}>{{ c }}</option>
          @end
        </select>
        <button class="btn btn--primary btn--sm" type="submit">Cari</button>
      </form>

      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Bahan</th>
              <th>Kategori</th>
              <th class="num">Energi (kkal)</th>
              <th class="num">Protein (g)</th>
              <th class="num">Lemak (g)</th>
              <th class="num">Serat (g)</th>
              <th>Sumber</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            @each(i in ingredients)
              <tr>
                <td>{{ i.name }}</td>
                <td class="small muted">{{ i.category }}</td>
                <td class="num">{{ fmt(i.kalori, 1) }}</td>
                <td class="num">{{ fmt(i.protein, 1) }}</td>
                <td class="num">{{ fmt(i.lemak, 1) }}</td>
                <td class="num">
                  @if(i.serat === null)
                    <span class="chip chip--warn">tidak ada data</span>
                  @else
                    {{ fmt(i.serat, 1) }}
                  @end
                </td>
                <td>
                  <span class="chip">{{ i.source === 'tkpi' ? 'TKPI' : 'kustom' }}</span>
                </td>
                <td class="right">
                  @if(i.source === 'kustom' && i.deviceId === deviceId)
                    <form method="POST" action="{{ urlFor('ingredients.destroy', { id: i.id }, { qs: { _method: 'DELETE' } }) }}" class="inline-form" x-data x-on:submit="if (!confirm('Hapus bahan ini?')) $event.preventDefault()">
                      {{ csrfField() }}
                      <button class="btn btn--ghost btn--sm" type="submit" aria-label="Hapus {{ i.name }}">
                        @svg('lucide:trash-2', { width: 14, height: 14 })
                      </button>
                    </form>
                  @end
                </td>
              </tr>
            @else
              <tr><td colspan="8" class="muted">Tidak ada bahan yang cocok.</td></tr>
            @end
          </tbody>
        </table>
      </div>

      <section class="panel vstack">
        <div>
          <h2 class="h2">Tambah bahan sendiri</h2>
          <p class="small muted">Untuk bahan yang belum ada. Isi nilai per 100 gram; serat boleh kosong bila tidak diketahui.</p>
        </div>
        <form method="POST" action="{{ urlFor('ingredients.store') }}" class="vstack">
          {{ csrfField() }}
          <div class="grid-2">
            @each(f in [{ key: 'name', label: 'Nama bahan', placeholder: 'Misal: Pepes ikan' }, { key: 'category', label: 'Kategori', placeholder: 'Misal: Lauk hewani' }])
              <div class="field">
                <label class="field__label" for="{{ f.key }}">{{ f.label }}</label>
                <input class="field__input" id="{{ f.key }}" name="{{ f.key }}" value="{{ old(f.key) ?? '' }}" placeholder="{{ f.placeholder }}" list="{{ f.key === 'category' ? 'category-list' : '' }}" />
                @if(errors[f.key])
                  <span class="field__error">{{ errors[f.key].join(' ') }}</span>
                @end
              </div>
            @end
          </div>
          <datalist id="category-list">
            @each(c in categories)
              <option value="{{ c }}"></option>
            @end
          </datalist>
          <div class="grid-4">
            @each(n in nutrients)
              <div class="field">
                <label class="field__label" for="new-{{ n.key }}">{{ n.label }} per 100 g ({{ n.unit }})</label>
                <input class="field__input num" id="new-{{ n.key }}" name="{{ n.key }}" inputmode="decimal" value="{{ old(n.key) ?? '' }}" placeholder="{{ n.key === 'serat' ? 'kosongkan bila tidak ada' : '0' }}" />
                @if(errors[n.key])
                  <span class="field__error">{{ errors[n.key].join(' ') }}</span>
                @end
              </div>
            @end
          </div>
          <div>
            <button class="btn btn--primary btn--sm" type="submit">Simpan bahan</button>
          </div>
        </form>
      </section>
    </div>
  @end
@end
