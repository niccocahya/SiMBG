# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Basis data
DB_FILE=db.sqlite3

# Kunci halaman parameter saat demo publik (true/false)
PARAMETERS_READONLY=false

# Rate limit
LIMITER_STORE=memory
